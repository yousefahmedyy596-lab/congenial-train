   "source": [
    "prices = map(float, input(' Enter prices: ').split())\n",
    " \n",
    "for price in prices :\n",
    "    if price < 50:\n",
    "        print(price,\"is Cheap\")\n",
    "    elif price < 100 :\n",
    "        print(price,\"is Mid\")\n",
    "    else :\n",
    "        print(price,\"is Expensive\")"
   ]
